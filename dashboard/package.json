{
  "name": "openemr-patient-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "React port of the OpenEMR patient dashboard widgets. Same visual layout as the existing Twig/PHP page (Bootstrap 4.6 cards), backed by OpenEMR's REST + FHIR R4 APIs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest --run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/fhir": "^0.0.42",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
